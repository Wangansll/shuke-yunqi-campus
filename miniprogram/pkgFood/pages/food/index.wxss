/* pkgFood/pages/food/index.wxss —— 校园美食鉴赏 */
.page { min-height: 100vh; background: #F6F4F0; padding-bottom: 40rpx; }

/* 顶部：杂志感的暖色 */
.hero { position: relative; overflow: hidden; padding: 38rpx 32rpx 30rpx; background: linear-gradient(150deg, #2A1B12 0%, #5B3423 55%, #8C4A28 100%); }
.h-grain {
  position: absolute; inset: 0;
  background-image: radial-gradient(circle at 84% 20%, rgba(255,214,150,0.24) 0, rgba(255,214,150,0) 44%),
    radial-gradient(circle at 8% 92%, rgba(255,255,255,0.10) 0, rgba(255,255,255,0) 40%);
}
.h-kicker { position: relative; font-size: 18rpx; color: #E4B98C; letter-spacing: 2rpx; }
.h-title { position: relative; margin-top: 12rpx; font-size: 50rpx; font-weight: 800; color: #FFF6E9; letter-spacing: 2rpx; }
.h-sub { position: relative; margin-top: 10rpx; font-size: 21rpx; color: #D9B896; }
.h-stats { position: relative; display: flex; align-items: baseline; margin-top: 24rpx; }

/* 右上「开饭」：菜在站内看，单去美团下 */
.h-order { position: absolute; top: 28rpx; right: 28rpx; z-index: 3; display: flex; align-items: center; gap: 12rpx; }
/* 会发光的按钮：刊头是深棕，光源直接落在贴纸上，像档口一直在喊「开饭」。
   三层叠：底下一团呼吸的径向光，外面一圈扩散的细环，字自己也在亮 */
.ho-glow {
  position: absolute; left: -80rpx; top: 50%; width: 264rpx; height: 264rpx; margin-top: -132rpx;
  border-radius: 50%; z-index: 0; pointer-events: none;
  background: radial-gradient(circle at 50% 50%,
    rgba(255,246,222,0.94) 0%, rgba(255,206,124,0.62) 24%,
    rgba(255,176,72,0.34) 44%, rgba(255,164,56,0.12) 62%, rgba(255,150,40,0) 78%);
  animation: hoGlow 2.4s ease-in-out infinite;
}
.ho-ring {
  position: absolute; left: -34rpx; top: 50%; width: 172rpx; height: 172rpx; margin-top: -86rpx;
  border-radius: 50%; z-index: 0; pointer-events: none;
  border: 3rpx solid rgba(255,226,166,0.92);
  animation: hoRing 2.4s ease-out infinite;
}
/* 饭团贴纸：白底、圆角，动画在贴纸里演，不压标题 */
.ho-badge {
  position: relative; z-index: 1;
  width: 104rpx; height: 104rpx; border-radius: 24rpx; overflow: hidden;
  background: #fff;
  /* 兜底：动画不跑也要有亮边，别退回一张平贴纸 */
  box-shadow: 0 10rpx 26rpx rgba(0,0,0,0.28), 0 0 0 2rpx rgba(255,220,162,0.5), 0 0 14rpx 0 rgba(255,186,92,0.30);
  animation: hoHalo 2.4s ease-in-out infinite;
}
.ho-gif { display: block; width: 104rpx; height: 104rpx; }
.ho-tx { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: flex-start; }
.ho-t {
  font-size: 29rpx; font-weight: 800; color: #FFF6E9; letter-spacing: 3rpx; line-height: 1.1;
  text-shadow: 0 0 10rpx rgba(255,196,110,0.5), 0 0 22rpx rgba(255,152,44,0.26);
  animation: hoWord 2.4s ease-in-out infinite;
}
.ho-s { margin-top: 8rpx; font-size: 18rpx; color: #F2D1A6; letter-spacing: 0.5rpx; animation: hoSub 2.4s ease-in-out infinite; }
.h-order-hv { opacity: 0.84; }

@keyframes hoGlow {
  0%, 100% { opacity: 0.44; transform: scale(0.9); }
  50% { opacity: 1; transform: scale(1.06); }
}
@keyframes hoRing {
  0% { opacity: 0; transform: scale(0.68); }
  22% { opacity: 0.95; }
  100% { opacity: 0; transform: scale(1.18); }
}
@keyframes hoHalo {
  0%, 100% {
    transform: scale(1);
    box-shadow: 0 10rpx 26rpx rgba(0,0,0,0.28),
      0 0 0 2rpx rgba(255,220,162,0.5),
      0 0 14rpx 0 rgba(255,186,92,0.30);
  }
  50% {
    transform: scale(1.015);
    box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.3),
      0 0 0 3rpx rgba(255,242,210,0.95),
      0 0 24rpx 4rpx rgba(255,198,108,0.85);
  }
}
@keyframes hoWord {
  0%, 100% { color: #FFEFD6; text-shadow: 0 0 8rpx rgba(255,200,120,0.42), 0 0 18rpx rgba(255,152,44,0.18); }
  50% { color: #FFFFFF; text-shadow: 0 0 9rpx rgba(255,246,214,1), 0 0 24rpx rgba(255,206,120,0.92), 0 0 42rpx rgba(255,166,54,0.62); }
}
@keyframes hoSub {
  0%, 100% { color: #F2D1A6; opacity: 0.82; }
  50% { color: #FFE9C8; opacity: 1; }
}
.hs { display: flex; align-items: baseline; }
.hs-n { font-size: 34rpx; font-weight: 800; color: #FFD8A6; }
.hs-k { margin-left: 8rpx; font-size: 18rpx; color: #C79E78; }
.hs-dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: rgba(255,216,166,0.45); margin: 0 22rpx; }

/* 三个视角 */
.tabs { display: flex; gap: 12rpx; padding: 20rpx 24rpx 4rpx; }
.tab {
  flex: 1; text-align: center; padding: 16rpx 0; border-radius: 16rpx;
  font-size: 24rpx; color: #6E5F52; background: #fff; border: 1rpx solid #E9E2D8;
}
.tab.on { background: #2A1B12; border-color: #2A1B12; color: #FFE7C4; font-weight: 700; }

/* 范围 */
.scopes { display: flex; gap: 12rpx; padding: 14rpx 24rpx 0; }
.sc {
  flex: 1; text-align: center; padding: 14rpx 0; border-radius: 14rpx;
  font-size: 21rpx; color: #8C7B6A; background: #FBF8F3; border: 1rpx solid #EDE6DC;
}
.sc.on { background: #B4551F; border-color: #B4551F; color: #FFF3E2; font-weight: 700; }

/* 搜索 */
.search {
  display: flex; align-items: center; gap: 10rpx;
  margin: 16rpx 24rpx 0; padding: 0 22rpx; height: 78rpx;
  background: #fff; border-radius: 16rpx; border: 1rpx solid #E9E2D8;
}
.s-ic { font-size: 30rpx; color: #B7A996; }
.s-in { flex: 1; font-size: 23rpx; color: #2A1B12; }
.s-clr { font-size: 19rpx; color: #B4551F; }

/* 品类 */
.cats { display: flex; white-space: nowrap; padding: 18rpx 24rpx 4rpx; }
.cat {
  flex-shrink: 0; display: flex; align-items: baseline; gap: 6rpx;
  padding: 12rpx 20rpx; margin-right: 12rpx; border-radius: 999rpx;
  background: #fff; border: 1rpx solid #EDE6DC;
}
.cat.on { background: #B4551F; border-color: #B4551F; }
.cat-n { font-size: 22rpx; color: #5C4C3E; }
.cat.on .cat-n { color: #fff; font-weight: 700; }
.cat-c { font-size: 17rpx; color: #A79A8C; margin-left: 2rpx; }
.cat.on .cat-c { color: rgba(255,255,255,0.72); }

.res { margin: 16rpx 30rpx 0; font-size: 19rpx; color: #A79A8C; }

/* 图鉴网格 */
.grid { display: flex; flex-wrap: wrap; gap: 16rpx; padding: 12rpx 24rpx 0; }
.dish {
  width: 340rpx; box-sizing: border-box; padding: 0 0 18rpx;
  background: #fff; border-radius: 22rpx; border: 1rpx solid #F0E9DF; overflow: hidden;
}
.d-ph {
  position: relative; width: 100%; height: 300rpx;
  background: linear-gradient(135deg, var(--c1, #F7F2EA), var(--c2, #EBE2D5));
  display: flex; align-items: center; justify-content: center;
}
.d-img { width: 100%; height: 100%; display: block; }
.d-ch { font-size: 92rpx; font-weight: 800; color: rgba(42,27,18,0.42); }
.d-sig {
  position: absolute; left: 0; top: 0;
  font-size: 17rpx; color: #FFF3E2; background: rgba(180,85,31,0.92);
  padding: 6rpx 14rpx; border-radius: 0 0 14rpx 0;
}
.d-n {
  margin: 14rpx 16rpx 0; font-size: 24rpx; font-weight: 700; color: #2A1B12; line-height: 1.4;
  overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
}
.d-shop {
  margin: 8rpx 16rpx 0; font-size: 18rpx; color: #A0917F;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.d-meta { display: flex; align-items: center; gap: 10rpx; margin: 8rpx 16rpx 0; }
.d-zone { font-size: 17rpx; color: #8C7B6A; background: #F7F2EA; padding: 3rpx 10rpx; border-radius: 6rpx; }
.d-sold { font-size: 17rpx; color: #B4551F; }

.more { margin: 20rpx 24rpx 0; text-align: center; padding: 22rpx 0; background: #fff; border-radius: 18rpx; color: #8C4A28; font-size: 22rpx; font-weight: 600; }
.empty { margin: 40rpx 24rpx; text-align: center; font-size: 21rpx; color: #B7A996; }

/* 榜单 */
.board-tip { margin: 18rpx 30rpx 8rpx; font-size: 18rpx; color: #A79A8C; line-height: 1.6; }
.rank { display: flex; align-items: center; gap: 14rpx; margin: 0 24rpx 10rpx; padding: 14rpx 18rpx; background: #fff; border-radius: 18rpx; }
.r-no { width: 44rpx; text-align: center; font-size: 24rpx; font-weight: 800; color: #C6B7A6; }
.r-no.top { color: #B4551F; font-size: 28rpx; }
.r-img { width: 76rpx; height: 76rpx; border-radius: 14rpx; flex-shrink: 0; background: #F7F2EA; }
.r-ic {
  width: 76rpx; height: 76rpx; border-radius: 14rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; font-weight: 800; color: rgba(42,27,18,0.5);
  background: linear-gradient(135deg, var(--c1, #F7F2EA), var(--c2, #EBE2D5));
}
.r-bd { flex: 1; min-width: 0; }
.r-n { font-size: 24rpx; font-weight: 600; color: #2A1B12; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.r-shop { margin-top: 4rpx; font-size: 18rpx; color: #A0917F; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.r-sold { font-size: 22rpx; font-weight: 700; color: #B4551F; flex-shrink: 0; }

/* 口碑：总体分布 */
.vsum { margin: 16rpx 24rpx 14rpx; padding: 22rpx 24rpx; background: #fff; border-radius: 20rpx; border: 1rpx solid #F0E9DF; }
.vs-hd { display: flex; align-items: flex-end; justify-content: space-between; }
.vs-l { display: flex; align-items: baseline; gap: 8rpx; }
.vs-n { font-size: 42rpx; font-weight: 800; color: #2A1B12; line-height: 1; }
.vs-k { font-size: 19rpx; color: #A0917F; }
.vs-pct { display: flex; align-items: baseline; gap: 6rpx; }
.vs-pv { font-size: 26rpx; font-weight: 800; color: #4E8A5A; }
.vs-pk { font-size: 17rpx; color: #A0917F; }
.vs-bar { display: flex; height: 12rpx; border-radius: 12rpx; overflow: hidden; margin-top: 16rpx; background: #F2ECE4; }
.vs-g { background: #4E8A5A; }
.vs-m { background: #C89A3C; }
.vs-b { background: #B2543C; }
.vs-key { display: flex; flex-wrap: wrap; gap: 8rpx 18rpx; margin-top: 12rpx; }
.vk { font-size: 17rpx; color: #8C7B6A; }
.vk.dim { color: #B7A996; }

/* 口碑 */
.shop { margin: 0 24rpx 12rpx; padding: 20rpx; background: #fff; border-radius: 20rpx; border: 1rpx solid #F0E9DF; }
.s-hd { display: flex; align-items: center; gap: 16rpx; }
.s-badge {
  flex-shrink: 0; font-size: 17rpx; font-weight: 700;
  padding: 6rpx 12rpx; border-radius: 8rpx;
}
.s-badge.in { color: #1B5BC0; background: #EAF1FE; }
.s-badge.out { color: #8C4A28; background: #FBEEE2; }
.s-tx { flex: 1; min-width: 0; }
.s-n { font-size: 25rpx; font-weight: 700; color: #2A1B12; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.s-m { margin-top: 6rpx; font-size: 18rpx; color: #A0917F; }
.s-a { font-size: 19rpx; color: #8C4A28; font-weight: 600; flex-shrink: 0; }
.s-rt { flex-shrink: 0; display: flex; align-items: baseline; gap: 4rpx; }
.s-c { font-size: 30rpx; font-weight: 800; color: #B4551F; line-height: 1; }
.s-cn { font-size: 17rpx; color: #A0917F; }

/* 每店一条细分布条，比一句文字更快看出口碑构成 */
.s-strip { display: flex; height: 6rpx; border-radius: 6rpx; overflow: hidden; margin-top: 14rpx; background: #F4EEE6; }
.ss.g { background: #4E8A5A; }
.ss.m { background: #C89A3C; }
.ss.b { background: #B2543C; }

.s-first {
  margin-top: 14rpx; font-size: 20rpx; color: #6E5F52; line-height: 1.6;
  background: #FAF6F0; border-radius: 12rpx; padding: 12rpx 14rpx;
  overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
}
.s-more { display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; font-size: 17rpx; color: #A0917F; }
.s-more.no-bar { margin-top: 10rpx; }
.s-more-b { color: #8C4A28; font-weight: 600; }
.s-more-dim { color: #B7A996; }
.s-fold { margin-top: 14rpx; text-align: center; font-size: 18rpx; color: #A0917F; }

/* 评价条目 */
.rv { margin-top: 14rpx; padding: 14rpx 16rpx; background: #FAF6F0; border-radius: 14rpx; }
.rv-hd { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; }
.rv-l { display: flex; align-items: center; gap: 10rpx; min-width: 0; }
.rv-u { font-size: 18rpx; color: #8C7B6A; font-weight: 600; }
.rv-t { flex-shrink: 0; font-size: 15rpx; font-weight: 700; padding: 2rpx 8rpx; border-radius: 6rpx; }
.rv-t.g { color: #3F7349; background: #E9F2E9; }
.rv-t.m { color: #8A6417; background: #F8EFD9; }
.rv-t.b { color: #8E3826; background: #FAE7E1; }
.rv-d { font-size: 17rpx; color: #B7A996; flex-shrink: 0; }
.rv-x { margin-top: 8rpx; font-size: 21rpx; color: #3E3228; line-height: 1.7; }
.rv-rec { margin-top: 10rpx; font-size: 17rpx; color: #8C4A28; background: #F6EDE2; display: inline-block; padding: 4rpx 12rpx; border-radius: 8rpx; }

.foot { margin: 26rpx 32rpx 0; }
.ft-line { display: block; font-size: 18rpx; color: #B7A996; line-height: 1.7; margin-bottom: 8rpx; }

/* 详情弹层 */
.mask { position: fixed; inset: 0; background: rgba(20,12,6,0.52); z-index: 98; }
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 99;
  max-height: 84vh; overflow-y: auto;
  background: #FFFDF9; border-radius: 28rpx 28rpx 0 0;
  padding: 12rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));
}
.sh-top { display: flex; justify-content: center; padding: 6rpx 0 16rpx; }
.sh-bar { width: 72rpx; height: 8rpx; border-radius: 8rpx; background: #E4D8C8; }
.sh-img { width: 100%; height: 400rpx; border-radius: 20rpx; background: #F7F2EA; }
.sh-ph {
  width: 100%; height: 300rpx; border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, var(--c1, #F7F2EA), var(--c2, #EBE2D5));
}
.sh-ch { font-size: 120rpx; font-weight: 800; color: rgba(42,27,18,0.35); }
.sh-n { margin-top: 20rpx; font-size: 32rpx; font-weight: 800; color: #2A1B12; line-height: 1.4; }
.sh-tags { display: flex; gap: 10rpx; margin-top: 12rpx; }
.tag { font-size: 17rpx; padding: 5rpx 12rpx; border-radius: 8rpx; }
.tag.cat { color: #8C4A28; background: #FFF3E2; }
.tag.sig { color: #fff; background: #B4551F; }
.tag.ai { color: #4B3E8C; background: #EFEBFF; }
.sh-m { margin-top: 10rpx; font-size: 20rpx; color: #A0917F; }
.sh-desc { margin-top: 16rpx; font-size: 22rpx; color: #5C4C3E; line-height: 1.7; }
.sh-sec { margin-top: 24rpx; font-size: 22rpx; font-weight: 700; color: #2A1B12; }
.sh-sec-n { margin-left: 10rpx; font-size: 17rpx; font-weight: 400; color: #A0917F; }
.sh-more { margin-top: 12rpx; font-size: 17rpx; color: #B7A996; text-align: center; }
.sh-shop-m { margin-top: 8rpx; font-size: 20rpx; color: #8C7B6A; }
.sh-close { margin-top: 26rpx; text-align: center; padding: 22rpx 0; border-radius: 999rpx; background: #2A1B12; color: #FFE7C4; font-size: 24rpx; font-weight: 700; }
