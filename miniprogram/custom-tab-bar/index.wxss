/* custom-tab-bar/index.wxss —— 图标内嵌 base64，不依赖图片文件加载 */
/* 页面内的 fixed 全屏层压不住 tabBar（框架把它渲染在页面容器之外），
   需要全屏浮层时由页面调 getTabBar().setData({hidden:true}) 临时隐藏 */
.tabbar.is-hidden { display: none; }
.tabbar {
  position: fixed; left: 0; right: 0; bottom: 0;
  /* 高度 = 内容区 112rpx + 安全区；必须 box-sizing:border-box 且把安全区算进总高，
     否则 safe-area 的 padding 会从内容区里吃掉高度，把图标压扁只露一半 */
  height: calc(112rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex; align-items: stretch;
  background: #ffffff;
  border-top: 1rpx solid #EDF0F6;
  box-shadow: 0 -4rpx 20rpx rgba(30,60,120,0.05);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}
.item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 8rpx 0 10rpx; }
.ico {
  width: 46rpx; height: 46rpx;
  flex: 0 0 auto;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}
.txt { margin-top: 4rpx; font-size: 20rpx; color: #9AA4B2; line-height: 1.2; flex: 0 0 auto; }
.txt.on { color: #2B6FE8; font-weight: 600; }
.ico-home { background-image: url("data:image/png;base64,"); }
.ico-home.on { background-image: url("data:image/png;base64,"); }
.ico-service { background-image: url("data:image/png;base64,"); }
.ico-service.on { background-image: url("data:image/png;base64,"); }
