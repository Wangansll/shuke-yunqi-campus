page { background: #F4F7FC; }

.page { min-height: 100vh; padding-bottom: calc(60rpx + env(safe-area-inset-bottom)); }

/* ---------- 顶部深蓝区块 ---------- */
.hero {
  position: relative; overflow: hidden;
  padding: 38rpx 32rpx 46rpx;
  background: linear-gradient(135deg, #0C2557 0%, #1D5FC0 100%);
  border-radius: 0 0 34rpx 34rpx;
}
.h-grid {
  position: absolute; inset: 0;
  background-image: linear-gradient(rgba(255,255,255,0.06) 1rpx, transparent 1rpx),
                    linear-gradient(90deg, rgba(255,255,255,0.06) 1rpx, transparent 1rpx);
  background-size: 56rpx 56rpx;
}
.h-halo {
  position: absolute; right: -90rpx; top: -110rpx; width: 340rpx; height: 340rpx;
  border-radius: 50%; background: radial-gradient(circle, rgba(120,190,255,0.42), transparent 68%);
}
.h-t { position: relative; font-size: 44rpx; font-weight: 800; color: #fff; letter-spacing: 1rpx; }
.h-s { position: relative; margin-top: 10rpx; font-size: 22rpx; color: rgba(255,255,255,0.72); line-height: 1.65; }

/* ---------- 卡片 ---------- */
.card {
  margin: 0 24rpx; padding: 26rpx 26rpx 28rpx;
  background: #fff; border-radius: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(15, 34, 66, 0.07);
}
.search { margin-top: -26rpx; position: relative; z-index: 2; }

/* ---------- 输入 ---------- */
.s-row {
  display: flex; align-items: center; gap: 12rpx;
  height: 92rpx; padding: 0 24rpx;
  background: #F4F7FC; border-radius: 20rpx;
}
.s-in { flex: 1; font-size: 30rpx; color: #0F1A33; letter-spacing: 1rpx; }
.s-ph { color: #A9B4C6; font-size: 26rpx; letter-spacing: 0; }
.s-clear {
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: #DCE3EE; color: #7A8699;
  font-size: 20rpx; display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}

.s-com {
  display: flex; align-items: center; gap: 14rpx;
  margin-top: 16rpx; padding: 0 22rpx; height: 84rpx;
  background: #fff; border: 1rpx solid #E7EDF7; border-radius: 20rpx;
}
.s-com-l { font-size: 24rpx; color: #7A8699; flex-shrink: 0; }
.s-com-v { flex: 1; text-align: right; font-size: 26rpx; color: #0F1A33; font-weight: 600; }
.s-com-a { font-size: 26rpx; color: #B4BDCC; }

/* 隐私面单：手机后四位 */
.s-phone {
  display: flex; align-items: center; gap: 14rpx;
  margin-top: 16rpx; padding: 0 22rpx; height: 84rpx;
  background: #fff; border: 1rpx solid #E7EDF7; border-radius: 20rpx;
}
.sp-in { flex: 1; text-align: right; font-size: 26rpx; color: #0F1A33; letter-spacing: 4rpx; }
.sp-ph { color: #B4BDCC; font-size: 22rpx; letter-spacing: 0; }

.s-btn {
  margin-top: 20rpx; height: 92rpx; border-radius: 999rpx;
  background: linear-gradient(135deg, #2B6FE8, #16459B);
  color: #fff; font-size: 30rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(43, 111, 232, 0.26);
}
.s-btn.off { opacity: 0.6; }

/* ---------- 轨迹 ---------- */
.res { margin-top: 24rpx; }
.r-hd {
  display: flex; align-items: baseline; gap: 14rpx;
  padding-bottom: 18rpx; border-bottom: 1rpx solid #F0F4FA;
}
.r-com { font-size: 26rpx; font-weight: 700; color: #0F1A33; }
.r-no { font-size: 20rpx; color: #94A0B2; letter-spacing: 0.5rpx; }

.tl { padding-top: 22rpx; }
.tli { position: relative; padding: 0 0 26rpx 34rpx; }
.tli::before {
  content: ''; position: absolute; left: 7rpx; top: 20rpx; bottom: 0;
  width: 2rpx; background: #E7EDF7;
}
.tli:last-child::before { display: none; }
.tl-dot {
  position: absolute; left: 0; top: 8rpx;
  width: 16rpx; height: 16rpx; border-radius: 50%;
  background: #C9D8F0;
}
.tli.on .tl-dot {
  width: 20rpx; height: 20rpx; left: -2rpx;
  background: #2B6FE8; box-shadow: 0 0 0 6rpx rgba(43, 111, 232, 0.14);
}
.tl-tx { font-size: 25rpx; color: #59657A; line-height: 1.6; }
.tli.on .tl-tx { font-size: 27rpx; color: #0F1A33; font-weight: 600; }
.tl-tm { margin-top: 6rpx; font-size: 19rpx; color: #A9B4C6; }

/* ---------- 失败 ---------- */
.fail { margin-top: 24rpx; }
.f-t { font-size: 26rpx; font-weight: 700; color: #B4551F; line-height: 1.6; }
.f-d { margin-top: 10rpx; font-size: 22rpx; color: #8B96A8; line-height: 1.65; }
.f-hint { margin-top: 10rpx; font-size: 20rpx; color: #8A6100; background: #FFF9EA; padding: 10rpx 14rpx; border-radius: 10rpx; line-height: 1.5; }
.f-btn {
  margin-top: 20rpx; height: 80rpx; border-radius: 999rpx;
  border: 1rpx solid #DDE7F5; background: #F7FAFF;
  color: #2B6FE8; font-size: 26rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}

/* ---------- 底部说明 ---------- */
.tip { margin: 30rpx 40rpx 0; }
.tip-t { font-size: 21rpx; font-weight: 700; color: #94A0B2; }
.tip-s { margin-top: 8rpx; font-size: 20rpx; color: #A9B4C6; line-height: 1.7; }
