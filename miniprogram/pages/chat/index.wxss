/* pages/chat/index.wxss */
.page { display: flex; flex-direction: column; height: 100vh; box-sizing: border-box; background: #F5F7FB; }
/* 自定义 tabBar 为 fixed 覆盖层，聊天区底部留出 tabBar + 安全区高度 */
.page.tab-page { height: calc(100vh - 112rpx - env(safe-area-inset-bottom)); }
.head {
  display: flex; align-items: center; gap: 18rpx; padding: 20rpx 28rpx;
  background: #fff; border-bottom: 1rpx solid #EDF0F6;
  flex-shrink: 0;
}
.avatar {
  width: 100rpx; height: 100rpx; border-radius: 30rpx; flex-shrink: 0;
  background: linear-gradient(160deg, #EEF5FF, #DEEAFF);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(43,111,232,0.16);
  overflow: hidden;
}
.av-img { width: 100rpx; height: 100rpx; }
.h-tx { flex: 1; min-width: 0; }
.h-name { font-size: 30rpx; font-weight: 700; color: #0F1A33; }
.online { font-size: 20rpx; color: #12B98C; font-weight: 500; margin-left: 8rpx; }
.h-sub { display: flex; align-items: center; gap: 8rpx; margin-top: 6rpx; }
.mchip {
  flex-shrink: 0; font-size: 19rpx; font-weight: 700; color: #fff;
  background: linear-gradient(135deg, #2B6FE8, #16409A);
  padding: 5rpx 12rpx; border-radius: 8rpx;
  letter-spacing: 0.4rpx; white-space: nowrap; word-spacing: 1rpx;
}
.clear { font-size: 24rpx; color: #7A869C; padding: 10rpx 16rpx; flex-shrink: 0; }

/* 滚动区必须显式限高：只写 flex:1 时 scroll-view 会跟着内容长高，
   长回答会把输入栏顶出屏幕（压在 tabBar 下面）。height:0 + flex:1 才是"占满剩余空间"。 */
.msgs { flex: 1 1 auto; height: 0; padding: 24rpx 24rpx 12rpx; }
.anchor { height: 1rpx; }
/* 欢迎页：内容量恒定，垂直居中比堆在顶部更稳（5 组轮播只露一组，底部不再空一大块） */
.welcome {
  text-align: center; padding: 20rpx 30rpx;
  min-height: 76vh; display: flex; flex-direction: column; justify-content: center;
}
/* 小栖形象：光晕 + 悬浮动效 */
.w-stage { position: relative; width: 340rpx; height: 300rpx; margin: 0 auto 2rpx; display: flex; align-items: center; justify-content: center; }
.w-halo {
  position: absolute; width: 300rpx; height: 300rpx; border-radius: 50%;
  background: radial-gradient(circle at 50% 44%, #E6F0FF 0%, #F4F8FF 58%, rgba(244,248,255,0) 74%);
}
.w-mascot { position: relative; width: 258rpx; height: 258rpx; animation: float 3.6s ease-in-out infinite; }
@keyframes float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-10rpx); } }
.w-bird {
  display: inline-block; margin: -18rpx auto 0;
  font-size: 17rpx; color: #1B5BC0; background: #fff;
  border: 1rpx solid #E1EBFB; padding: 3rpx 18rpx; border-radius: 20rpx;
  box-shadow: 0 4rpx 10rpx rgba(30,60,120,0.06);
}
.w-t { font-size: 34rpx; font-weight: 700; color: #0F1A33; margin-top: 12rpx; }
.w-id { display: flex; align-items: center; justify-content: center; gap: 8rpx; margin-top: 12rpx; }
.w-id-chip {
  font-size: 17rpx; font-weight: 700; color: #fff;
  background: linear-gradient(135deg,#2B6FE8,#16409A);
  padding: 4rpx 10rpx; border-radius: 7rpx;
}
.w-id-tx { font-size: 21rpx; color: #7A869C; }
.w-s { font-size: 24rpx; color: #7A869C; line-height: 1.8; margin-top: 14rpx; }
.w-chips { display: flex; flex-wrap: wrap; gap: 14rpx; justify-content: center; }
.w-group { margin-top: 26rpx; }
.w-group-t {
  font-size: 20rpx; color: #9AA4B2; letter-spacing: 3rpx;
  margin-bottom: 14rpx; text-align: center;
}
.w-chip { font-size: 23rpx; color: #2B6FE8; background: #E8F0FE; padding: 14rpx 22rpx; border-radius: 30rpx; }

/* 快捷问题轮播：固定高度，一屏一组，底部小圆点指示 */
.w-swiper { height: 218rpx; margin-top: 4rpx; }
.w-swiper .w-group { margin-top: 0; }

.msg { display: flex; margin-bottom: 28rpx; }
.msg.user { justify-content: flex-end; }
.msg.assistant { justify-content: flex-start; }
.bubble {
  max-width: 82%; padding: 20rpx 26rpx; border-radius: 22rpx;
  font-size: 27rpx; line-height: 1.7; white-space: pre-wrap;
  word-break: normal; overflow-wrap: break-word;
}
.msg.user .bubble { background: linear-gradient(135deg,#2B6FE8,#1E5FD6); color: #fff; border-bottom-right-radius: 6rpx; }
.msg.assistant .bubble { background: #fff; color: #1A2340; border-bottom-left-radius: 6rpx; box-shadow: 0 4rpx 16rpx rgba(30,60,120,0.05); }
.typing { color: #7A869C; }
.cursor { color: #2B6FE8; }

/* ---- 检索来源（RAG 证据） ---- */
.h-kb { font-size: 18rpx; color: #9AA4B2; }
.refs { margin: -18rpx 0 26rpx 0; }
.refs-hd {
  display: inline-flex; align-items: center; gap: 8rpx;
  padding: 8rpx 14rpx 8rpx 8rpx; border-radius: 20rpx;
  background: #F0F4FC; border: 1rpx solid #E1E9F8;
}
.refs-badge {
  min-width: 30rpx; height: 30rpx; line-height: 30rpx; text-align: center;
  border-radius: 8rpx; background: #2B6FE8; color: #fff;
  font-size: 19rpx; font-weight: 600; padding: 0 6rpx;
}
.refs-tx { font-size: 21rpx; color: #4A5875; }
.refs-act { font-size: 21rpx; color: #2B6FE8; margin-left: 4rpx; }
.refs-bd {
  margin-top: 10rpx; background: #FFFFFF; border: 1rpx solid #EDF0F6;
  border-radius: 18rpx; padding: 8rpx 18rpx;
}
.ref-row { display: flex; align-items: flex-start; gap: 12rpx; padding: 12rpx 0; border-bottom: 1rpx solid #F4F6FA; }
.ref-row:last-child { border-bottom: none; }
.ref-no {
  width: 30rpx; height: 30rpx; line-height: 30rpx; text-align: center;
  border-radius: 50%; background: #E8F0FE; color: #2B6FE8;
  font-size: 18rpx; flex: 0 0 auto; margin-top: 2rpx;
}
.ref-info { display: flex; flex-direction: column; flex: 1; min-width: 0; }
.ref-name { font-size: 23rpx; color: #1A2340; }
.ref-src { font-size: 19rpx; color: #9AA4B2; margin-top: 4rpx; }

.inputbar {
  display: flex; align-items: flex-end; gap: 14rpx; padding: 18rpx 24rpx;
  background: #fff; border-top: 1rpx solid #EDF0F6;
  flex-shrink: 0; /* 内容再多也不许被压缩 */
}
/* 多行输入：内容多了自动长高（最多约 5 行），不再把整句话藏在一行里 */
.cin {
  flex: 1; width: 0; min-height: 80rpx; max-height: 220rpx;
  background: #F5F7FB; border-radius: 24rpx;
  padding: 20rpx 24rpx; font-size: 26rpx; line-height: 40rpx;
}
.cbtn {
  height: 80rpx; padding: 0 32rpx; border-radius: 24rpx; flex-shrink: 0;
  background: linear-gradient(135deg,#2B6FE8,#1E5FD6); color: #fff;
  font-size: 26rpx; font-weight: 600; display: flex; align-items: center; justify-content: center;
}
.cbtn.stop { background: #FF6B5B; }

/* 回答下面的"接着办"操作条 */
.acts { display: flex; flex-wrap: wrap; gap: 12rpx; margin: -12rpx 0 22rpx 0; }
.act {
  display: inline-flex; align-items: center; gap: 8rpx;
  padding: 11rpx 20rpx 11rpx 14rpx; border-radius: 999rpx;
  background: #fff; border: 1rpx solid #DCE7FA;
  box-shadow: 0 4rpx 14rpx rgba(30,60,120,0.07);
}
.act:active { background: #EAF2FF; border-color: #C9DDFB; }
.act-ic { font-size: 23rpx; line-height: 1; }
.act-n { font-size: 23rpx; font-weight: 600; color: #1B5BC0; }
.act-a { font-size: 22rpx; color: #9AA9C4; }
