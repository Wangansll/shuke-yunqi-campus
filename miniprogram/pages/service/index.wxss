/* pages/service/index.wxss */
.page {
  min-height: 100vh; padding: 8rpx 0 40rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #F7FAFF 22%, #EFF4FC 100%);
}
.top { padding: 34rpx 36rpx 2rpx; }
.t-en { font-size: 18rpx; font-weight: 600; color: #A9B8D0; letter-spacing: 6rpx; }
.t1 { font-size: 46rpx; font-weight: 800; color: #0F1A33; letter-spacing: 1rpx; margin-top: 10rpx; }
.t2 { font-size: 21rpx; color: #8290A8; margin-top: 12rpx; line-height: 1.6; }
.sec-h { display: flex; align-items: flex-end; justify-content: space-between; margin: 42rpx 36rpx 18rpx; }
.top + .sec-h { margin-top: 36rpx; }
.sec-l { display: flex; flex-direction: column; }
.sec-t { font-size: 30rpx; font-weight: 800; color: #0F1A33; letter-spacing: 0.5rpx; line-height: 1.1; }
.sec-e { font-size: 16rpx; font-weight: 600; color: #B3BFD2; letter-spacing: 4rpx; margin-top: 8rpx; }
.rt { font-size: 19rpx; color: #1B4EA8; background: rgba(43,111,232,0.10); border: 1rpx solid rgba(43,111,232,0.20); padding: 5rpx 14rpx; border-radius: 20rpx; font-weight: 600; margin-bottom: 4rpx; }

/* ---------- 通用白卡 ---------- */
.card {
  background: #fff; border: 1rpx solid #E7EEFA; border-radius: 26rpx;
  box-shadow: 0 1rpx 2rpx rgba(16,40,90,0.03), 0 10rpx 26rpx -16rpx rgba(20,45,95,0.30);
}

/* ---------- Bento 网格 ---------- */
.grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin: 0 28rpx; }
.tile {
  position: relative; overflow: hidden;
  background: #fff; border: 1rpx solid #E7EEFA; border-radius: 26rpx;
  padding: 24rpx; box-sizing: border-box;
  box-shadow: 0 1rpx 2rpx rgba(16,40,90,0.03), 0 10rpx 26rpx -16rpx rgba(20,45,95,0.30);
}
.wide { width: 100%; flex: 0 0 auto; }
.half { width: 48%; flex: 0 0 auto; display: flex; flex-direction: column; }
.third { width: 31.4%; flex: 0 0 auto; display: flex; flex-direction: column; align-items: flex-start; }

/* 主卡：橙色渐变，呼应首页美食鉴赏卡（白盒橙碗 + 白底标签） */
.feat {
  background: linear-gradient(150deg, #FFA36B 0%, #F58449 52%, #DB6531 100%);
  border: 1rpx solid rgba(255,255,255,0.18); padding: 26rpx 24rpx 22rpx;
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.35), 0 16rpx 32rpx -12rpx rgba(210,110,60,0.45);
}
.feat::after {
  content: ''; position: absolute; right: -70rpx; top: -90rpx;
  width: 300rpx; height: 300rpx; border-radius: 50%;
  border: 1rpx solid rgba(255,255,255,0.26);
  box-shadow: inset 0 0 0 44rpx rgba(255,255,255,0.075), inset 0 0 0 88rpx rgba(255,255,255,0.05);
}
.feat-in { display: flex; align-items: center; gap: 18rpx; position: relative; z-index: 1; }
.feat .sn { color: #FFFFFF; }
.feat .sd { color: rgba(255,255,255,0.72); }
.ic {
  width: 72rpx; height: 72rpx; border-radius: 20rpx; flex-shrink: 0;
  background: none; display: flex; align-items: center; justify-content: center; font-size: 42rpx; line-height: 1;
}
.ic.lg { width: 84rpx; height: 84rpx; border-radius: 24rpx; font-size: 44rpx; background: none; }
.ic.sm { width: 56rpx; height: 56rpx; border-radius: 16rpx; font-size: 34rpx; }
.ic.alt { background: none; }
.ic.pic { background: transparent; padding: 0; overflow: hidden; }
.ic-logo { width: 100%; height: 100%; display: block; }
.ic-img { width: 100%; height: 100%; display: block; }
.tx { flex: 1; min-width: 0; }
.sn { font-size: 27rpx; font-weight: 600; color: #0F1A33; }
.sn.sm { font-size: 21rpx; margin-top: 10rpx; line-height: 1.3; }
.sd { font-size: 21rpx; color: #7A869C; margin-top: 6rpx; line-height: 1.4; }
.half .sn { margin-top: 14rpx; }
.feat .ic.pic { background: #FFFFFF; padding: 12rpx; box-sizing: border-box; border-radius: 22rpx; box-shadow: 0 6rpx 16rpx rgba(120,30,0,0.22); }
.feat-tag {
  flex-shrink: 0; font-size: 18rpx; font-weight: 700; color: #D9691F;
  background: rgba(255,255,255,0.92); padding: 5rpx 14rpx; border-radius: 8rpx;
  box-shadow: 0 4rpx 10rpx -3rpx rgba(120,30,0,0.40);
}
.feat-addr {
  position: relative; z-index: 1;
  display: flex; align-items: center; gap: 8rpx;
  margin-top: 20rpx; padding: 13rpx 16rpx;
  background: rgba(255,255,255,0.18); border: 1rpx solid rgba(255,255,255,0.28); border-radius: 14rpx;
}
.fa-pin { font-size: 20rpx; }
.fa-pin-img { width: 26rpx; height: 26rpx; flex-shrink: 0; }
.fa-tx { font-size: 19rpx; color: rgba(255,255,255,0.90); }

/* 小卡右上角编号：白卡上唯一的花活，代价是零 */
.idx {
  position: absolute; right: 20rpx; top: 16rpx;
  font-size: 20rpx; font-weight: 700; color: #C7D4E9; letter-spacing: 1rpx;
}
/* 通栏尾卡 */
.tail { display: flex; align-items: center; gap: 18rpx; padding: 20rpx 24rpx; }
.go { font-size: 38rpx; color: #C4CDDB; }
/* 求职准备：与通栏尾卡同一套横排，但图标上给一点浅底，跟"练习"这件事对上 */
.ivcard { display: flex; align-items: center; gap: 18rpx; padding: 20rpx 24rpx; }
.ivcard .ic.lg { background: #EDF3FE; border-radius: 22rpx; }
/* 吉利卡：呼应首页吉利专区（同款深蓝渐变 + 白盒蓝字标） */
.gcard-s {
  background:
    radial-gradient(90% 80% at 6% 0%, rgba(110,180,255,0.60) 0%, rgba(110,180,255,0) 56%),
    radial-gradient(80% 90% at 100% 100%, rgba(0,60,190,0.65) 0%, rgba(0,60,190,0) 60%),
    linear-gradient(126deg, #04123F 0%, #0A2F87 46%, #1B5FD0 100%);
  border: none;
  box-shadow: 0 14rpx 34rpx rgba(6,26,74,0.32);
}
.gcard-s .ic.lg { background: #FFFFFF; padding: 12rpx; box-sizing: border-box; border-radius: 22rpx; box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.16); }
.gcard-s .g-lock-s { width: 58rpx; height: 31rpx; display: block; }
.gcard-s .sn { color: #FFFFFF; }
.gcard-s .sd { color: rgba(255,255,255,0.66); }
.gcard-s .go { color: rgba(255,255,255,0.45); }
/* 平台大卡：顶部一道渐变色条，比加盒子省事也更像一个"平台" */
.plat { padding-bottom: 20rpx; }
.plat::before {
  content: ''; position: absolute; left: 0; top: 0; width: 100%; height: 6rpx;
  background: linear-gradient(90deg, #2B6FE8 0%, #6FA9FF 62%, rgba(111,169,255,0) 100%);
}
.plat-go { margin-top: auto; padding-top: 16rpx; font-size: 19rpx; font-weight: 700; color: #1B5BC0; }

.addr { margin: 34rpx 28rpx 0; padding: 24rpx 26rpx; }
.addr-t { font-size: 18rpx; color: #A0AEC4; letter-spacing: 3rpx; font-weight: 600; }
.addr-n { font-size: 28rpx; font-weight: 700; color: #1A2340; margin-top: 10rpx; display: flex; align-items: center; }
.addr-pin { width: 30rpx; height: 30rpx; margin-right: 6rpx; }
.addr-d { font-size: 22rpx; color: #7A869C; margin-top: 8rpx; line-height: 1.6; }

.mask { position: fixed; inset: 0; background: rgba(15,25,45,0.45); z-index: 1000; }
/* 自定义 tabBar 是独立层级，页面内容盖不住它，所以弹层改为浮在导航栏上方 */
.sheet {
  position: fixed; left: 24rpx; right: 24rpx;
  bottom: calc(124rpx + env(safe-area-inset-bottom)); z-index: 1001;
  background: #fff; border-radius: 32rpx;
  padding: 28rpx 32rpx 36rpx;
  transform: translateY(calc(100% + 160rpx)); transition: transform .25s ease;
  max-height: 76vh; overflow-y: auto;
  box-shadow: 0 -8rpx 40rpx rgba(20,40,80,0.12);
}
.sheet.show { transform: translateY(0); }
.sh-h { display: flex; align-items: center; justify-content: space-between; }
.sh-title { font-size: 34rpx; font-weight: 800; color: #1A2340; }
.sh-x { font-size: 44rpx; color: #AEB7C6; line-height: 1; }
.sh-body { margin-top: 24rpx; }
.hero-tag {
  display: inline-block; font-size: 22rpx; color: #2B6FE8;
  background: #E8F0FE; padding: 8rpx 20rpx; border-radius: 24rpx;
}
.desc { font-size: 26rpx; color: #48546B; line-height: 1.75; margin: 20rpx 0 8rpx; }
.plat { margin-top: 24rpx; background: #F5F8FF; border-radius: 20rpx; padding: 26rpx; }
.plat-name { font-size: 28rpx; font-weight: 700; color: #1A2340; }
.plat-note { font-size: 23rpx; color: #7A869C; margin-top: 8rpx; line-height: 1.6; }
.plat-btns { display: flex; gap: 16rpx; margin-top: 24rpx; }
.pb { flex: 1; text-align: center; padding: 18rpx 0; border-radius: 40rpx; font-size: 26rpx; font-weight: 600; background: #fff; color: #2B6FE8; border: 2rpx solid #2B6FE8; }
.pb.main { background: linear-gradient(135deg,#2B6FE8,#1E5FD6); color: #fff; border: none; }
.no-data { text-align: center; padding: 40rpx 20rpx; color: #7A869C; font-size: 26rpx; }
.nd-ic { font-size: 64rpx; color: #CBD3E0; margin-bottom: 12rpx; }
.nd-s { font-size: 22rpx; color: #AEB7C6; margin-top: 10rpx; }

/* 校园导览卡（站内可查）：浅蓝整底，和白卡错开 */
.tour {
  background: linear-gradient(152deg, #E9F1FF 0%, #F4F9FF 58%, #FFFFFF 100%);
  border-color: #D9E6FA; padding: 26rpx 24rpx;
}
.tour-in { display: flex; align-items: center; gap: 18rpx; }
.tour-chips { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 20rpx; }
.tchip {
  font-size: 19rpx; color: #2A477A; background: rgba(255,255,255,0.86);
  border: 1rpx solid #D7E4F8; padding: 7rpx 16rpx; border-radius: 999rpx;
}

/* 站外入口（从首页搬来） */
.jump { margin: 0 24rpx; padding: 4rpx 22rpx; }
.j-row { display: flex; align-items: center; gap: 16rpx; padding: 22rpx 0; border-bottom: 1rpx solid #F1F5FB; }
.j-row:last-child { border-bottom: none; }
.j-ic { width: 56rpx; height: 56rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 36rpx; background: none; }
.j-img { width: 44rpx; height: 44rpx; display: block; }
.j-tx { flex: 1; min-width: 0; }
.j-n { font-size: 25rpx; font-weight: 600; color: #1A2340; }
.j-tag { font-size: 17rpx; color: #1B4EA8; background: #EAF1FE; padding: 3rpx 10rpx; border-radius: 8rpx; margin-left: 10rpx; }
.j-s { font-size: 19rpx; color: #7A869C; margin-top: 5rpx; }
.j-go {
  font-size: 19rpx; color: #1B4EA8; font-weight: 700; flex-shrink: 0;
  background: #EAF1FE; padding: 7rpx 16rpx; border-radius: 999rpx;
}
.jump-note { margin: 16rpx 32rpx 0; font-size: 18rpx; color: #A9B2C2; line-height: 1.65; }
