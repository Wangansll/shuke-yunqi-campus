<!-- pages/wiki/index.wxml —— 校园百科 -->
<view class="page">
  <view class="hero">
    <view class="h-grid"></view>
    <view class="h-t">校园百科</view>
    <view class="h-s">官网整站语料 + 学校文件，共 {{total}} 条 · 搜到就给你原文链接</view>
  </view>

  <!-- 搜索 -->
  <view class="card search">
    <view class="s-row">
      <input class="s-in" value="{{q}}" placeholder="搜：校历 / 奖学金 / 转专业 / 宿舍"
        placeholder-class="s-ph" confirm-type="search" bindinput="onInput" bindconfirm="doSearch" />
      <view class="s-btn {{loading ? 'off' : ''}}" bindtap="doSearch">{{loading ? '…' : '搜索'}}</view>
    </view>
    <view class="hots">
      <view class="hot" wx:for="{{hot}}" wx:key="*this" data-w="{{item}}" bindtap="pickHot">{{item}}</view>
    </view>
  </view>

  <view class="tip" wx:if="{{tip}}">{{tip}}</view>

  <!-- 结果 -->
  <block wx:if="{{items.length}}">
    <view class="sec-t">搜索结果（{{items.length}} 条）</view>
    <view class="r-card" wx:for="{{items}}" wx:key="u" data-i="{{index}}" bindtap="toggle">
      <view class="r-hd">
        <text class="r-t">{{item.t}}</text>
        <text class="r-tag">{{item.c}}</text>
      </view>
      <view class="r-x {{openIdx === index ? 'open' : ''}}">{{item.x}}</view>
      <view class="r-ft">
        <text class="r-d">{{item.d || '官网'}}</text>
        <text class="r-a" catchtap="copyLink" data-u="{{item.u}}">复制原文链接</text>
      </view>
    </view>
  </block>

  <!-- 官方图册：点一张铺满整行，再点收回；右上角放大看原图 -->
  <view class="sec-t">官方图册（点击看大图）</view>
  <view class="g-grid">
    <view class="g-card {{wide===item.k?'wide':''}}" wx:for="{{galleryView}}" wx:key="k" data-k="{{item.k}}" bindtap="tapCard">
      <view class="g-frame">
        <image class="g-img" src="{{item.src}}" mode="{{wide===item.k?'widthFix':'aspectFill'}}" lazy-load />
        <view class="g-zoom" data-src="{{item.src}}" catchtap="zoom">⤢</view>
        <view class="g-hint" wx:if="{{wide===item.k}}">再点一下收回</view>
      </view>
      <view class="g-n">{{item.n}}</view>
      <view class="g-d">{{item.d}}</view>
    </view>
  </view>
  <view class="note">图片来自学校官网「校园地图 / 最新校历 / 标识文化」三页，已压缩到可离线看。点图铺满整行，⤢ 看原图可双指放大。</view>
</view>
